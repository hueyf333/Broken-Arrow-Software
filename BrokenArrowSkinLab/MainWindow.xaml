<Window
    x:Class="BrokenArrowSkinLab.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BrokenArrowSkinLab"
    xmlns:vm="using:BrokenArrowSkinLab.ViewModels"
    xmlns:models="using:BrokenArrowSkinLab.Models"
    Title="Broken Arrow Skin Lab"
    MinWidth="1024"
    MinHeight="768">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="New Project" Command="{x:Bind ViewModel.NewProjectCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Open Project..." Command="{x:Bind ViewModel.OpenProjectCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Save Project" Command="{x:Bind ViewModel.SaveProjectCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Save Project As..." Command="{x:Bind ViewModel.SaveProjectAsCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="S"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Export Single Frame..." Command="{x:Bind ViewModel.ExportSingleFrameCommand}"/>
                <MenuFlyoutItem Text="Export Sprite Sheet..." Command="{x:Bind ViewModel.ExportSpriteSheetCommand}"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Exit" Click="OnExitClick"/>
            </MenuBarItem>
            <MenuBarItem Title="Edit">
                <MenuFlyoutItem Text="Add Layer" Command="{x:Bind ViewModel.AddLayerCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="L"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Remove Layer" Command="{x:Bind ViewModel.RemoveLayerCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Duplicate Layer" Command="{x:Bind ViewModel.DuplicateLayerCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="D"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="View">
                <MenuFlyoutItem Text="Zoom In" Command="{x:Bind ViewModel.ZoomInCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Add"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Zoom Out" Command="{x:Bind ViewModel.ZoomOutCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Subtract"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Reset Zoom" Command="{x:Bind ViewModel.ResetZoomCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Number0"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
        </MenuBar>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Layers -->
            <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Layers" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8"/>

                <ListView Grid.Row="1" 
                         ItemsSource="{x:Bind ViewModel.CurrentFrameLayers, Mode=OneWay}"
                         SelectedItem="{x:Bind ViewModel.SelectedLayer, Mode=TwoWay}"
                         SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Layer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{x:Bind IsVisible, Mode=TwoWay}" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <CommandBar Grid.Row="2" DefaultLabelPosition="Right">
                    <AppBarButton Icon="Add" Label="Add" Command="{x:Bind ViewModel.AddLayerCommand}"/>
                    <AppBarButton Icon="Delete" Label="Remove" Command="{x:Bind ViewModel.RemoveLayerCommand}"/>
                    <AppBarButton Icon="Copy" Label="Duplicate" Command="{x:Bind ViewModel.DuplicateLayerCommand}"/>
                    <AppBarSeparator/>
                    <AppBarButton Icon="Up" Label="Up" Command="{x:Bind ViewModel.MoveLayerUpCommand}"/>
                    <AppBarButton Icon="Down" Label="Down" Command="{x:Bind ViewModel.MoveLayerDownCommand}"/>
                </CommandBar>
            </Grid>

            <!-- Center Panel - Canvas -->
            <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Canvas Area -->
                <Border Grid.Row="0" Background="#FF333333" Margin="16">
                    <Viewbox Stretch="Uniform">
                        <Canvas x:Name="PreviewCanvas" 
                               Width="{x:Bind ViewModel.CurrentProject.CanvasWidth, Mode=OneWay}" 
                               Height="{x:Bind ViewModel.CurrentProject.CanvasHeight, Mode=OneWay}"
                               Background="White"/>
                    </Viewbox>
                </Border>

                <!-- Frame Scrubber -->
                <Grid Grid.Row="1" Padding="16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CommandBar Grid.Column="0" DefaultLabelPosition="Right">
                        <AppBarButton Icon="Add" Label="Add Frame" Command="{x:Bind ViewModel.AddFrameCommand}"/>
                        <AppBarButton Icon="Delete" Label="Remove Frame" Command="{x:Bind ViewModel.RemoveFrameCommand}"/>
                    </CommandBar>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Text="Frame:" VerticalAlignment="Center"/>
                        <Slider x:Name="FrameSlider" 
                               Minimum="0" 
                               Maximum="{x:Bind ViewModel.CurrentProject.FrameCount - 1, Mode=OneWay}"
                               Value="{x:Bind ViewModel.CurrentFrame, Mode=TwoWay}"
                               Width="200"
                               VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="{x:Bind ViewModel.CurrentFrame, Mode=OneWay}"/>
                            <Run Text="/"/>
                            <Run Text="{x:Bind ViewModel.CurrentProject.FrameCount - 1, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="-" Command="{x:Bind ViewModel.ZoomOutCommand}" Width="32"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="50" TextAlignment="Center">
                            <Run Text="{x:Bind ViewModel.ZoomLevel, Mode=OneWay}"/>
                            <Run Text="x"/>
                        </TextBlock>
                        <Button Content="+" Command="{x:Bind ViewModel.ZoomInCommand}" Width="32"/>
                        <Button Content="Reset" Command="{x:Bind ViewModel.ResetZoomCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Right Panel - Properties -->
            <Grid Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="8">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <TextBlock Text="Properties" Style="{StaticResource SubtitleTextBlockStyle}"/>

                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SelectedLayer, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                            <!-- Layer Name -->
                            <TextBlock Text="Layer Name" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBox Text="{x:Bind ViewModel.SelectedLayer.Name, Mode=TwoWay}" PlaceholderText="Layer name"/>

                            <!-- Transform -->
                            <TextBlock Text="Transform" Style="{StaticResource BaseTextBlockStyle}" Margin="0,8,0,0"/>
                            
                            <TextBlock Text="Position X" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <Slider Minimum="0" Maximum="{x:Bind ViewModel.CurrentProject.CanvasWidth, Mode=OneWay}" 
                                   Value="{x:Bind ViewModel.SelectedLayer.Position.X, Mode=TwoWay}"/>
                            
                            <TextBlock Text="Position Y" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <Slider Minimum="0" Maximum="{x:Bind ViewModel.CurrentProject.CanvasHeight, Mode=OneWay}"
                                   Value="{x:Bind ViewModel.SelectedLayer.Position.Y, Mode=TwoWay}"/>
                            
                            <TextBlock Text="Scale" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <Slider Minimum="0.1" Maximum="3.0" StepFrequency="0.1"
                                   Value="{x:Bind ViewModel.SelectedLayer.Scale.X, Mode=TwoWay}"/>
                            
                            <TextBlock Text="Rotation" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <Slider Minimum="0" Maximum="360"
                                   Value="{x:Bind ViewModel.SelectedLayer.Rotation, Mode=TwoWay}"/>

                            <!-- Appearance -->
                            <TextBlock Text="Appearance" Style="{StaticResource BaseTextBlockStyle}" Margin="0,8,0,0"/>
                            
                            <TextBlock Text="Opacity" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <Slider Minimum="0" Maximum="1" StepFrequency="0.01"
                                   Value="{x:Bind ViewModel.SelectedLayer.Opacity, Mode=TwoWay}"/>

                            <!-- Shape Type -->
                            <TextBlock Text="Shape Type" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <ComboBox SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Circle"/>
                                <ComboBoxItem Content="Rectangle"/>
                                <ComboBoxItem Content="Rounded Rectangle"/>
                                <ComboBoxItem Content="Ellipse"/>
                            </ComboBox>

                            <!-- Size -->
                            <TextBlock Text="Width" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <Slider Minimum="10" Maximum="500"
                                   Value="{x:Bind ViewModel.SelectedLayer.Size.X, Mode=TwoWay}"/>
                            
                            <TextBlock Text="Height" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <Slider Minimum="10" Maximum="500"
                                   Value="{x:Bind ViewModel.SelectedLayer.Size.Y, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Grid Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center">
                <Run Text="Project:"/>
                <Run Text="{x:Bind ViewModel.CurrentProject.Name, Mode=OneWay}"/>
            </TextBlock>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                <TextBlock VerticalAlignment="Center">
                    <Run Text="Canvas:"/>
                    <Run Text="{x:Bind ViewModel.CurrentProject.CanvasWidth, Mode=OneWay}"/>
                    <Run Text="x"/>
                    <Run Text="{x:Bind ViewModel.CurrentProject.CanvasHeight, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{x:Bind ViewModel.IsDirty, Mode=OneWay, Converter={StaticResource DirtyToTextConverter}}" 
                          VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
