<UserControl
    x:Class="BrokenArrowSkinLab.App.Views.KnobDesignerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BrokenArrowSkinLab.App.Views"
    xmlns:vm="using:BrokenArrowSkinLab.App.ViewModels"
    Background="{ThemeResource SystemControlBackgroundAltHighBrush}">

    <UserControl.DataContext>
        <vm:KnobDesignerViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel - Layers -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8" Spacing="4">
                <Button Content="Add Layer" Command="{Binding AddLayerCommand}" 
                       Style="{ThemeResource AccentButtonStyle}"/>
                <Button Content="Remove" Command="{Binding RemoveLayerCommand}"/>
                <Button Content="▲" Command="{Binding MoveLayerUpCommand}" Width="36"/>
                <Button Content="▼" Command="{Binding MoveLayerDownCommand}" Width="36"/>
            </StackPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Layers}"
                     SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
                     DisplayMemberPath="Name"
                     Margin="8"
                     Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                     Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>

            <TextBlock Grid.Row="2" Text="Layer Properties" FontWeight="Bold" Margin="8,16,8,8"
                      Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8" Spacing="8" DataContext="{Binding SelectedLayer}">
                    <TextBlock Text="Name:" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBox Text="{Binding Name, Mode=TwoWay}"
                            Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>

                    <TextBlock Text="Type:" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    <ComboBox SelectedItem="{Binding Type, Mode=TwoWay}" HorizontalAlignment="Stretch"
                             Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                             Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}">
                        <ComboBoxItem Content="Background"/>
                        <ComboBoxItem Content="Ring"/>
                        <ComboBoxItem Content="Ticks"/>
                        <ComboBoxItem Content="Pointer"/>
                        <ComboBoxItem Content="Gloss"/>
                        <ComboBoxItem Content="Shadow"/>
                        <ComboBoxItem Content="Text"/>
                    </ComboBox>

                    <CheckBox Content="Visible" IsChecked="{Binding Visible, Mode=TwoWay}"
                             Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>

                    <TextBlock Text="Opacity:" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    <Slider Value="{Binding Opacity, Mode=TwoWay}" Minimum="0" Maximum="1" 
                           StepFrequency="0.1"/>
                    <TextBlock Text="{Binding Opacity, Mode=OneWay}" 
                              Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

                    <TextBlock Text="Blend Mode:" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    <ComboBox SelectedItem="{Binding BlendMode, Mode=TwoWay}" HorizontalAlignment="Stretch"
                             Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                             Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}">
                        <ComboBoxItem Content="Normal"/>
                        <ComboBoxItem Content="Multiply"/>
                        <ComboBoxItem Content="Screen"/>
                    </ComboBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Center/Right Panel - Preview and Export -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Preview" FontWeight="Bold" Margin="8"
                      Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>

            <Border Grid.Row="1" BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                   BorderThickness="1" Background="#2D2D30" Margin="8">
                <Viewbox Stretch="Uniform">
                    <Image Source="{Binding PreviewImage, Mode=OneWay}"
                          Width="{Binding CurrentKnob.Width}"
                          Height="{Binding CurrentKnob.Height}"/>
                </Viewbox>
            </Border>

            <StackPanel Grid.Row="2" Margin="8" Spacing="8">
                <TextBlock Text="Frame:" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                <Slider Value="{Binding PreviewFrameIndex, Mode=TwoWay}"
                       Minimum="0"
                       Maximum="63"
                       StepFrequency="1"/>
                <TextBlock Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}">
                    <Run Text="Frame: "/>
                    <Run Text="{Binding PreviewFrameIndex, Mode=OneWay}"/>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Export Filmstrip" Command="{Binding ExportFilmstripCommand}"
                           Style="{ThemeResource AccentButtonStyle}"/>
                    <Button Content="Export Sequence" Command="{Binding ExportSequenceCommand}"/>
                    <Button Content="Export Atlas" Command="{Binding ExportAtlasCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Status Bar -->
        <Grid Grid.Row="2" Grid.Column="1" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" Height="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusText}" 
                      VerticalAlignment="Center" Margin="8,0"
                      Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>

            <ProgressRing Grid.Column="1" IsActive="{Binding IsRendering}" 
                         Width="16" Height="16" Margin="8,0"/>
        </Grid>
    </Grid>
</UserControl>
