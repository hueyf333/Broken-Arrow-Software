<UserControl x:Class="SkinningStudio.Views.InspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SkinningStudio.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" 
                   Text="Inspector" 
                   FontSize="14" 
                   FontWeight="Bold" 
                   Margin="5"
                   Padding="5"
                   Background="{StaticResource SurfaceBrush}"/>
        
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10" DataContext="{Binding SelectedElement}">
                <TextBlock Text="No element selected" 
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,20">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Name -->
                    <TextBlock Text="Name:" Margin="0,5,0,2"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <!-- Element Type -->
                    <TextBlock Text="Type:" Margin="0,5,0,2"/>
                    <TextBlock Text="{Binding ElementType}" Margin="0,0,0,10" Foreground="{StaticResource TextSecondaryBrush}"/>

                    <!-- Position -->
                    <TextBlock Text="Position:" Margin="0,5,0,2" FontWeight="Bold"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Grid.Column="1" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="3" Text="Y:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Grid.Column="4" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <!-- Size -->
                    <TextBlock Text="Size:" Margin="0,5,0,2" FontWeight="Bold"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="W:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="3" Text="H:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Grid.Column="4" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <!-- Text -->
                    <TextBlock Text="Text:" Margin="0,5,0,2"/>
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,0,10"
                             AcceptsReturn="True"
                             Height="60"
                             VerticalScrollBarVisibility="Auto"/>

                    <!-- Z-Index -->
                    <TextBlock Text="Z-Index:" Margin="0,5,0,2"/>
                    <TextBox Text="{Binding ZIndex, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <!-- Visibility -->
                    <CheckBox Content="Visible" IsChecked="{Binding IsVisible}" Margin="0,5"/>
                    <CheckBox Content="Locked" IsChecked="{Binding IsLocked}" Margin="0,5"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
