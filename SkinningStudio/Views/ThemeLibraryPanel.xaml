<UserControl x:Class="SkinningStudio.Views.ThemeLibraryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SkinningStudio.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" 
                   Text="Theme Library" 
                   FontSize="14" 
                   FontWeight="Bold" 
                   Margin="5"
                   Padding="5"
                   Background="{StaticResource SurfaceBrush}"/>
        
        <TabControl Margin="5">
            <TabItem Header="Themes">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="5">
                        <TextBlock Text="Current Theme:" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Project.Themes}" 
                                  SelectedItem="{Binding Project.CurrentTheme}"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="New" Command="{Binding CreateThemeCommand}" Margin="0,0,5,0" Padding="10,3"/>
                            <Button Content="Duplicate" Command="{Binding DuplicateThemeCommand}" Margin="0,0,5,0" Padding="10,3"/>
                            <Button Content="Delete" Command="{Binding DeleteThemeCommand}" Padding="10,3"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="5" DataContext="{Binding Project.CurrentTheme}">
                            <TextBlock Text="Color Tokens:" FontWeight="Bold" Margin="0,10,0,5"/>
                            <ItemsControl ItemsSource="{Binding ColorTokens}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding Name}" 
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" 
                                                    Height="20" 
                                                    BorderBrush="{StaticResource BorderBrush}" 
                                                    BorderThickness="1">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding Color}"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Typography Tokens:" FontWeight="Bold" Margin="0,20,0,5"/>
                            <ItemsControl ItemsSource="{Binding TypographyTokens}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding Key}" 
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Value}" 
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            
            <TabItem Header="Styles">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Style States" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Button Content="Normal" Margin="0,2" HorizontalAlignment="Stretch"/>
                        <Button Content="Hover" Margin="0,2" HorizontalAlignment="Stretch"/>
                        <Button Content="Pressed" Margin="0,2" HorizontalAlignment="Stretch"/>
                        <Button Content="Disabled" Margin="0,2" HorizontalAlignment="Stretch" IsEnabled="False"/>
                        <Button Content="Focused" Margin="0,2" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
