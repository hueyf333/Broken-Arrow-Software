<Window x:Class="SkinningStudio.Views.Dialogs.ShortcutsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Shortcuts" 
        Height="500" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Keyboard Shortcuts" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="File Operations" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="New Project"/>
                        <TextBlock Grid.Column="1" Text="Ctrl+N" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Open Project"/>
                        <TextBlock Grid.Column="1" Text="Ctrl+O" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Save Project"/>
                        <TextBlock Grid.Column="1" Text="Ctrl+S" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <TextBlock Text="Edit Operations" FontWeight="Bold" Margin="0,15,0,5"/>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Undo"/>
                        <TextBlock Grid.Column="1" Text="Ctrl+Z" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Redo"/>
                        <TextBlock Grid.Column="1" Text="Ctrl+Y" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Cut"/>
                        <TextBlock Grid.Column="1" Text="Ctrl+X" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Copy"/>
                        <TextBlock Grid.Column="1" Text="Ctrl+C" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Paste"/>
                        <TextBlock Grid.Column="1" Text="Ctrl+V" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Selection" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Select All"/>
                        <TextBlock Grid.Column="1" Text="Ctrl+A" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Duplicate"/>
                        <TextBlock Grid.Column="1" Text="Ctrl+D" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Delete"/>
                        <TextBlock Grid.Column="1" Text="Delete" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <TextBlock Text="Multi-Selection" FontWeight="Bold" Margin="0,15,0,5"/>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Add to Selection"/>
                        <TextBlock Grid.Column="1" Text="Ctrl+Click" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Toggle Selection"/>
                        <TextBlock Grid.Column="1" Text="Shift+Click" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Button Grid.Row="2" 
                Content="Close" 
                Width="80" 
                Height="30"
                HorizontalAlignment="Center"
                Margin="0,15,0,0"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
