<UserControl x:Class="SkinningStudio.Views.HierarchyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SkinningStudio.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="250">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" 
                   Text="Hierarchy" 
                   FontSize="14" 
                   FontWeight="Bold" 
                   Margin="5"
                   Padding="5"
                   Background="{StaticResource SurfaceBrush}"/>
        
        <TreeView x:Name="ElementTree"
                  ItemsSource="{Binding Project.RootElements}" 
                  Margin="5">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsVisible}" 
                                  Margin="0,0,5,0" 
                                  VerticalAlignment="Center"
                                  ToolTip="Visibility"/>
                        <TextBlock Text="{Binding Name}" 
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElementType, StringFormat=' ({0})'}" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
