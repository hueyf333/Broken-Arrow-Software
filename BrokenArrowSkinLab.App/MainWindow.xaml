<Window x:Class="BrokenArrowSkinLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BrokenArrowSkinLab.App"
        xmlns:vm="clr-namespace:BrokenArrowSkinLab.App.ViewModels"
        xmlns:views="clr-namespace:BrokenArrowSkinLab.App.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    
    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open Project..." Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="_Save" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _As..." Command="{Binding SaveProjectAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" InputGestureText="Alt+F4"/>
            </MenuItem>
            
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="Cu_t" Command="{Binding CutCommand}" InputGestureText="Ctrl+X"/>
                <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C"/>
                <MenuItem Header="_Paste" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V"/>
                <MenuItem Header="_Delete" Command="{Binding DeleteCommand}" InputGestureText="Del"/>
                <Separator/>
                <MenuItem Header="_Preferences..." Command="{Binding PreferencesCommand}"/>
            </MenuItem>
            
            <MenuItem Header="_View">
                <MenuItem Header="_Zoom In" InputGestureText="Ctrl++"/>
                <MenuItem Header="Zoom _Out" InputGestureText="Ctrl+-"/>
                <MenuItem Header="Zoom to _Fit" InputGestureText="Ctrl+0"/>
                <Separator/>
                <MenuItem Header="Show _Grid" IsCheckable="True" IsChecked="True"/>
                <MenuItem Header="Show _Rulers" IsCheckable="True"/>
            </MenuItem>
            
            <MenuItem Header="_Tools">
                <MenuItem Header="New _Knob" Command="{Binding NewKnobCommand}"/>
                <MenuItem Header="New _Layout" Command="{Binding NewLayoutCommand}"/>
                <Separator/>
                <MenuItem Header="Run _Self Test" Command="{Binding RunSelfTestCommand}"/>
            </MenuItem>
            
            <MenuItem Header="_Help">
                <MenuItem Header="_Documentation"/>
                <MenuItem Header="_About..." Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>
        
        <!-- Toolbar -->
        <ToolBar DockPanel.Dock="Top">
            <Button Content="New" Command="{Binding NewProjectCommand}" ToolTip="New Project (Ctrl+N)"/>
            <Button Content="Open" Command="{Binding OpenProjectCommand}" ToolTip="Open Project (Ctrl+O)"/>
            <Button Content="Save" Command="{Binding SaveProjectCommand}" ToolTip="Save Project (Ctrl+S)"/>
            <Separator/>
            <Button Content="Undo" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)"/>
            <Button Content="Redo" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)"/>
            <Separator/>
            <Button Content="New Knob" Command="{Binding NewKnobCommand}" ToolTip="Create New Knob"/>
            <Button Content="New Layout" Command="{Binding NewLayoutCommand}" ToolTip="Create New Layout"/>
        </ToolBar>
        
        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Ready" />
            </StatusBarItem>
        </StatusBar>
        
        <!-- Main Content Area -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Panel - Project Explorer -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Project Explorer" FontWeight="Bold" 
                          Margin="5" Background="#F0F0F0" Padding="5"/>
                
                <TabControl Grid.Row="1">
                    <TabItem Header="Knobs">
                        <ListBox ItemsSource="{Binding Knobs}" DisplayMemberPath="Name"/>
                    </TabItem>
                    <TabItem Header="Layouts">
                        <ListBox ItemsSource="{Binding Layouts}" DisplayMemberPath="Name"/>
                    </TabItem>
                </TabControl>
            </Grid>
            
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
            
            <!-- Center Panel - Workspace -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Workspace" FontWeight="Bold" 
                          Margin="5" Background="#F0F0F0" Padding="5"/>
                
                <TabControl Grid.Row="1">
                    <TabItem Header="Knob Designer">
                        <views:KnobDesignerView DataContext="{Binding KnobDesigner}"/>
                    </TabItem>
                    <TabItem Header="Skin Layout Designer">
                        <views:LayoutDesignerView DataContext="{Binding LayoutDesigner}"/>
                    </TabItem>
                </TabControl>
            </Grid>
            
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>
            
            <!-- Right Panel - Properties Inspector -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Properties" FontWeight="Bold" 
                          Margin="5" Background="#F0F0F0" Padding="5"/>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Project Properties" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Name:"/>
                        <TextBox Text="{Binding CurrentProject.Name, UpdateSourceTrigger=PropertyChanged}" 
                                Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Version:"/>
                        <TextBox Text="{Binding CurrentProject.Version, UpdateSourceTrigger=PropertyChanged}" 
                                Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Created:"/>
                        <TextBlock Text="{Binding CurrentProject.Created, StringFormat='yyyy-MM-dd HH:mm:ss'}" 
                                  Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Modified:"/>
                        <TextBlock Text="{Binding CurrentProject.Modified, StringFormat='yyyy-MM-dd HH:mm:ss'}" 
                                  Margin="0,0,0,10"/>
                        
                        <Separator Margin="0,10"/>
                        
                        <TextBlock Text="Settings" FontWeight="Bold" Margin="0,10,0,10"/>
                        
                        <TextBlock Text="Grid Size:"/>
                        <TextBox Text="{Binding CurrentProject.Settings.GridSize, UpdateSourceTrigger=PropertyChanged}" 
                                Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Theme:"/>
                        <ComboBox SelectedValue="{Binding CurrentProject.Settings.Theme}" 
                                 Margin="0,0,0,10">
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
