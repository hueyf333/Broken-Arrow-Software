<UserControl x:Class="BrokenArrowSkinLab.App.Views.KnobDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BrokenArrowSkinLab.App.Views"
             xmlns:vm="clr-namespace:BrokenArrowSkinLab.App.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <UserControl.DataContext>
        <vm:KnobDesignerViewModel />
    </UserControl.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Panel - Layers -->
        <DockPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                <Button Content="Add Layer" Command="{Binding AddLayerCommand}" Margin="0,0,5,0"/>
                <Button Content="Remove" Command="{Binding RemoveLayerCommand}" Margin="0,0,5,0"/>
                <Button Content="▲" Command="{Binding MoveLayerUpCommand}" Width="30" Margin="0,0,2,0"/>
                <Button Content="▼" Command="{Binding MoveLayerDownCommand}" Width="30"/>
            </StackPanel>
            
            <ListBox DockPanel.Dock="Top" 
                     ItemsSource="{Binding Layers}" 
                     SelectedItem="{Binding SelectedLayer}"
                     DisplayMemberPath="Name"
                     Height="200"
                     Margin="5"/>
            
            <TextBlock DockPanel.Dock="Top" Text="Layer Properties" FontWeight="Bold" Margin="5"/>
            
            <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="5" DataContext="{Binding SelectedLayer}">
                    <TextBlock Text="Name:"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Type:"/>
                    <ComboBox SelectedItem="{Binding Type}" Margin="0,0,0,10">
                        <ComboBox.ItemsSource>
                            <x:Array Type="{x:Type System:String}" xmlns:System="clr-namespace:System;assembly=mscorlib">
                                <System:String>Background</System:String>
                                <System:String>Ring</System:String>
                                <System:String>Ticks</System:String>
                                <System:String>Pointer</System:String>
                                <System:String>Gloss</System:String>
                                <System:String>Shadow</System:String>
                                <System:String>Text</System:String>
                            </x:Array>
                        </ComboBox.ItemsSource>
                    </ComboBox>
                    
                    <CheckBox Content="Visible" IsChecked="{Binding Visible}" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Opacity:"/>
                    <Slider Value="{Binding Opacity}" Minimum="0" Maximum="1" TickFrequency="0.1" 
                           IsSnapToTickEnabled="True" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Opacity, StringFormat='{}{0:F2}'}" HorizontalAlignment="Right" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Blend Mode:"/>
                    <ComboBox SelectedItem="{Binding BlendMode}" Margin="0,0,0,10">
                        <ComboBox.ItemsSource>
                            <x:Array Type="{x:Type System:String}" xmlns:System="clr-namespace:System;assembly=mscorlib">
                                <System:String>Normal</System:String>
                                <System:String>Multiply</System:String>
                                <System:String>Screen</System:String>
                            </x:Array>
                        </ComboBox.ItemsSource>
                    </ComboBox>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
        
        <GridSplitter Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
        
        <!-- Center Panel - Preview and Export -->
        <DockPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Preview" FontWeight="Bold" Margin="5"/>
            
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="5">
                <Button Content="Export Filmstrip" Command="{Binding ExportFilmstripCommand}" Margin="0,0,5,0"/>
                <Button Content="Export Sequence" Command="{Binding ExportSequenceCommand}" Margin="0,0,5,0"/>
                <Button Content="Export Atlas" Command="{Binding ExportAtlasCommand}"/>
            </StackPanel>
            
            <StackPanel DockPanel.Dock="Bottom" Margin="5">
                <TextBlock Text="Frame:" />
                <Slider Value="{Binding PreviewFrameIndex}" 
                       Minimum="0" 
                       Maximum="{Binding CurrentKnob.FrameCount, FallbackValue=63}"
                       TickFrequency="1"
                       IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding PreviewFrameIndex, StringFormat='Frame: {0}'}" />
            </StackPanel>
            
            <Border BorderBrush="Gray" BorderThickness="1" Background="White" Margin="5">
                <Viewbox Stretch="Uniform">
                    <Image Source="{Binding PreviewImage}" 
                          Width="{Binding CurrentKnob.Width, FallbackValue=64}"
                          Height="{Binding CurrentKnob.Height, FallbackValue=64}"
                          RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Viewbox>
            </Border>
        </DockPanel>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Grid.Column="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="100" Height="16" IsIndeterminate="{Binding IsRendering}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
