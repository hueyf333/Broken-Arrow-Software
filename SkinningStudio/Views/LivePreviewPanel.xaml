<UserControl x:Class="SkinningStudio.Views.LivePreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SkinningStudio.Views"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="800">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" 
                   Text="Live Preview" 
                   FontSize="14" 
                   FontWeight="Bold" 
                   Margin="5"
                   Padding="5"
                   Background="{StaticResource SurfaceBrush}"/>
        
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="5">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas Width="2000" Height="1000" Background="{StaticResource BackgroundBrush}">
                    <ItemsControl ItemsSource="{Binding Project.RootElements}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style>
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                <Setter Property="Canvas.ZIndex" Value="{Binding ZIndex}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Width="{Binding Width}" Height="{Binding Height}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementType}" Value="Button">
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <Button Content="{Binding Text}" 
                                                                    HorizontalAlignment="Stretch" 
                                                                    VerticalAlignment="Stretch"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementType}" Value="Label">
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <Label Content="{Binding Text}" 
                                                                   HorizontalAlignment="Stretch" 
                                                                   VerticalAlignment="Stretch"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementType}" Value="TextBox">
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <TextBox Text="{Binding Text}" 
                                                                     HorizontalAlignment="Stretch" 
                                                                     VerticalAlignment="Stretch"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementType}" Value="CheckBox">
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <CheckBox Content="{Binding Text}" 
                                                                      HorizontalAlignment="Stretch" 
                                                                      VerticalAlignment="Stretch"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementType}" Value="Slider">
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <Slider HorizontalAlignment="Stretch" 
                                                                    VerticalAlignment="Center"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementType}" Value="Panel">
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <Border Background="{StaticResource SurfaceBrush}" 
                                                                    BorderBrush="{StaticResource BorderBrush}" 
                                                                    BorderThickness="1">
                                                                <TextBlock Text="{Binding Name}" 
                                                                           Margin="5" 
                                                                           VerticalAlignment="Top"/>
                                                            </Border>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementType}" Value="Image">
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <Border Background="{StaticResource SurfaceBrush}" 
                                                                    BorderBrush="{StaticResource BorderBrush}" 
                                                                    BorderThickness="1">
                                                                <TextBlock Text="[Image]" 
                                                                           HorizontalAlignment="Center" 
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
